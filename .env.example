# Local development defaults to data/aip.sqlite3 with authentication disabled.
# Hosted values must be configured in the provider secret store, not committed.
DATABASE_URL=data/aip.sqlite3
AIP_HOSTED=false
AIP_AUTH_ENABLED=false
AIP_COACH_USERNAME=coach
AIP_COACH_PASSWORD_HASH=
AIP_SESSION_SECRET=
AIP_TRUST_PROXY=false
